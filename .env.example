# bun run setup creates .env with a random signing secret.
PAYLOAD_SECRET=
DATABASE_URL=file:./data/payload.db
MEDIA_DIR=./media
CMS_URL=http://localhost:3000
SITE_URL=http://localhost:4321
# For preview across your own production subdomains, e.g. .example.com.
PAYLOAD_COOKIE_DOMAIN=
# Seed an admin only when both values are set. Otherwise create one at /admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
