{
  "name": "@starter/cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "payload build",
    "start": "srvx --prod --host 0.0.0.0 --dir=. --static=dist/client --entry=dist/server/server.js",
    "check": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "payload run src/seed.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@payloadcms/db-d1-sqlite": "4.0.0-beta.3",
    "@payloadcms/db-sqlite": "4.0.0-beta.3",
    "@payloadcms/graphql": "4.0.0-beta.3",
    "@payloadcms/richtext-lexical": "4.0.0-beta.3",
    "@payloadcms/storage-r2": "4.0.0-beta.3",
    "@payloadcms/tanstack-start": "4.0.0-beta.3",
    "@payloadcms/transformer-sharp": "4.0.0-beta.3",
    "@payloadcms/ui": "4.0.0-beta.3",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "graphql": "16.11.0",
    "payload": "4.0.0-beta.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.4",
    "srvx": "0.11.21"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.21",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "imports": {
    "#platform": "./src/platform.node.ts"
  }
}
